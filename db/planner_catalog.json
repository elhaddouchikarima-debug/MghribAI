  "budgetEstimatorRules": {
    "currency": "MAD",
    "requiredInputs": [
      "destination",
      "travelDays",
      "travellers",
      "totalBudgetMAD",
      "travelMonth"
    ],
    "optionalInputs": [
      "accommodationLevel",
      "foodStyle",
      "interests",
      "transportMode"
    ],
    "rules": [
      "Never convert missing prices to 0 MAD.",
      "Mark each estimate as live_quote, source_verified, user_provided, or unverified_estimate.",
      "Separate accommodation, food, intercity transport, local transport, activities and contingency.",
      "Include return/intercity transport only when origin and route are known.",
      "For accommodation, price per room/night and calculate room count from traveller count only when occupancy is known.",
      "Do not recommend a paid activity as affordable until its price or quote is available.",
      "Show a confidence label and the date each price was checked.",
      "Keep an emergency/contingency amount separate from planned spending."
    ],
    "recommendedOutputFields": [
      "estimatedTotalMAD",
      "dailyAverageMAD",
      "accommodationTotalMAD",
      "foodTotalMAD",
      "transportTotalMAD",
      "activitiesTotalMAD",
      "contingencyMAD",
      "priceConfidence",
      "priceCheckedAt",
      "sources"
    ]
  },
  "sourcePolicy": {
    "preferredSources": [
      "Official Moroccan National Tourist Office / Visit Morocco",
      "Official attraction or museum website for admission and hours",
      "Official transport operator for schedules and fares",
      "Accommodation provider's own booking page for dated room quotes",
      "Restaurant's current menu or direct provider quote"
    ],
    "avoid": [
      "Treating an old blog price as a current price",
      "Assuming a place is open because it appears in a dataset",
      "Assuming null or missing price means free",
      "Inventing GPS coordinates, opening hours, ratings or availability"
    ]
  }
